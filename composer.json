{
    "name": "hpd/validatify",
    "type": "library",
    "description": "A PHP input validation library.",
    "keywords": [
      "validation",
      "validator",
      "input validator"
    ],
    "homepage": "https://github.com/hamid-hpd/validatify",
    "authors": [
      {
        "name": "Hamid HpD",
        "email": "hpd.hamid@gmail.com"
      }
    ],
    "license": "proprietary",
  
    "require": {
      "php": "^8.0"
    },
    "minimum-stability": "stable",
  
    "autoload": {
      "psr-4": {
        "Hpd\\Validatify\\": "src/"
      }
    },
  
    "autoload-dev": {
      "psr-4": {
        "Hpd\\Validatify\\Test\\": "tests/"
      }
    },
  
    "require-dev": {
      "phpunit/phpunit": "^11.5"
    },
  
    "scripts": {
      "test": "phpunit tests/"
    },
    "support": {
      "issues": "https://github.com/hamid-hpd/validatify/issues",
      "source": "https://github.com/hamid-hpd/validatify"
    }
  }
  